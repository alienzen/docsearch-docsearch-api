# ── docsearch-api — Variables d'environnement ────────────────

ES_HOST=http://es01:9200
ES_INDEX=documents
REDIS_HOST=redis

# ── Environnement ────────────────────────────────────────────
# "production" VERROUILLE tous les contournements de développement listés
# en bas de ce fichier : l'API refuse de démarrer si l'un d'eux est armé,
# plutôt que de l'ignorer (voir app/auth/guardrails.py). Toute autre valeur
# vaut « développement ».
API_ENV=development

# ── Jetons de session (RS256) ────────────────────────────────
# Générer la paire AVANT le premier démarrage — sans elle, aucune session
# ne peut s'ouvrir et /auth/login répond 503 :
#   sudo install -d -o 1000 -g 1000 -m 700 /etc/docsearch/jwt
#   sudo podman run --rm -v /etc/docsearch/jwt:/etc/docsearch/jwt:Z \
#        localhost/docsearch/api:latest python scripts/generer-cles.py
# (un conteneur jetable, pas `podman exec` : l'unité monte ce dossier en
#  lecture seule, et l'UID 1000 est celui de l'utilisateur du conteneur)
# La commande affiche les trois lignes ci-dessous, à recopier telles
# quelles. Les clés vivent hors du dépôt et hors de l'image, montées en
# lecture seule par l'unité Quadlet.
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY_PATH=/etc/docsearch/jwt/<kid>/private.pem
JWT_PUBLIC_KEY_PATH=/etc/docsearch/jwt/<kid>/public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# Tolérance sur un jeton de rafraîchissement déjà tourné. Deux onglets qui
# se réveillent ensemble renouvellent ensemble : sans cette fenêtre, le
# second est refusé et son onglet repasse par la page de connexion, en
# perdant l'écran en cours. Un jeton présenté dans la fenêtre ne rend qu'un
# jeton d'accès, jamais une nouvelle session. 0 = comportement strict.
REFRESH_ROTATION_GRACE_SECONDS=30

# Cookies de session. COOKIE_SECURE=false uniquement pour une recette en
# clair (port 8090) — en production, le reverse-proxy est en HTTPS.
# Mal réglé, le symptôme est MUET : la connexion réussit, puis le
# navigateur refuse de renvoyer un cookie Secure sur du clair et chaque
# page ramène au formulaire. L'API l'avertit une fois par démarrage.
# COOKIE_SAMESITE=strict protège le mieux, mais renvoie au formulaire
# quiconque arrive par un lien collé dans un mail ou un portail intranet :
# passer à "lax" si c'est le mode d'accès normal de vos utilisateurs.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Tentatives de connexion ÉCHOUÉES tolérées, par identifiant ET par IP.
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

# ── LDAP / Active Directory ──────────────────────────────────
# LDAP_ENABLED=false : filtrage ACL uniquement sur les groupes POSIX, et
# plus personne ne peut se connecter en dehors des comptes de secours.
LDAP_ENABLED=false
# ldaps:// est le schéma attendu. "ldap://" (port 389, en clair) exige la
# dérogation explicite ci-dessous — une installation existante qui bindait
# en clair doit donc poser ce drapeau sciemment lors de la mise à jour.
LDAP_HOST=ldaps://dc01.domaine.gouv.fr
LDAP_BASE=dc=domaine,dc=gouv,dc=fr
LDAP_BINDDN=cn=svc-docsearch,ou=services,dc=domaine,dc=gouv,dc=fr
LDAP_PASS=changeme

# Validation du certificat LDAPS. Vide = magasin de certificats système.
LDAP_CA_CERT_FILE=
# Dérogation : bind en clair. Journalisée en WARNING à CHAQUE connexion.
LDAP_ALLOW_PLAINTEXT_INSECURE=false
LDAP_USE_STARTTLS=false

# Un annuaire lent ne doit jamais bloquer un worker sans limite.
LDAP_CONNECT_TIMEOUT_SECONDS=5
LDAP_RECEIVE_TIMEOUT_SECONDS=10
# Mise en cache des groupes. Trop long : une exclusion de groupe met
# d'autant plus de temps à prendre effet. Trop court : un aller-retour
# annuaire sur le chemin de chaque recherche.
LDAP_GROUP_CACHE_TTL_SECONDS=60

# Filtre de recherche d'un utilisateur. Le défaut couvre OpenLDAP (uid) et
# Active Directory (sAMAccountName). {username} est TOUJOURS échappé avant
# formatage — ne jamais reconstruire ce filtre ailleurs.
# LDAP_USER_FILTER_TEMPLATE=(|(uid={username})(sAMAccountName={username}))
# Repli si l'annuaire n'expose pas memberOf sur l'entrée utilisateur.
# LDAP_GROUP_SEARCH_BASE=ou=groups,dc=domaine,dc=gouv,dc=fr

# ── Groupes d'autorisation ───────────────────────────────────
# Droit d'utiliser DocSearch. Vide = accès désactivé pour tout le monde
# (refus par défaut plutôt que permissivité par défaut).
ACCESS_GROUP=docsearch-users
# Droit d'administrer, EN PLUS du précédent.
ADMIN_GROUP=docsearch-admins

# ── Connexion automatique Kerberos / SPNEGO ──────────────────
# L'INTERRUPTEUR est dans le panneau d'administration (réglage à chaud
# sso_kerberos_enabled), désactivé par défaut. Ce qui suit ne peut pas se
# régler à chaud : des chemins de fichiers et un nom de realm.
#
# Prérequis d'infrastructure, sans lesquels rien ne fonctionnera quelle que
# soit la configuration : un FQDN (le navigateur dérive le SPN du nom
# d'hôte de l'URL — il ne tente RIEN contre une adresse IP littérale), son
# enregistrement DNS, un compte de service, un SPN HTTP/<fqdn>, un
# certificat TLS au même nom, et une stratégie de parc autorisant les
# navigateurs à envoyer un ticket (Firefox :
# network.negotiate-auth.trusted-uris ; Chrome/Edge : AuthServerAllowlist).
KERBEROS_REALM=
# Keytab : jamais dans l'image ni dans le dépôt, monté en lecture seule.
# ⚠️  En Podman rootless, ses permissions 0600 sont interprétées avec l'UID
# MAPPÉ dans le conteneur — un keytab lisible sur l'hôte peut rester
# illisible dedans.
KERBEROS_KEYTAB=/etc/docsearch/krb5/docsearch.keytab
# Restreint le principal accepté quand le keytab en porte plusieurs.
KERBEROS_SPN=

# ── Journal ──────────────────────────────────────────────────
# Index ES des tentatives de connexion — succès ET échecs.
LOGIN_EVENTS_INDEX=login_events

# ── ⚠️  CONTOURNEMENTS DE DÉVELOPPEMENT ⚠️  ──────────────────
# Chacun suffit à donner l'identité de son choix à n'importe qui. Tous
# refusés AU DÉMARRAGE si API_ENV=production : l'API ne sert alors aucune
# requête, plutôt que de les ignorer en silence.
#
# Identité par défaut de toute requête non authentifiée.
DEV_USER=
# Croit l'en-tête HTTP X-User sur parole — c'était le comportement
# historique de DocSearch, et la raison pour laquelle un simple
# `curl -H "X-User: alice.admin" http://hôte:8000/admin/status` suffisait à
# administrer l'application. Nécessaire au proxy de recette
# (port 8090, ./manage.sh dev-user).
TRUST_X_USER_HEADER=false
# Ouvre une session Kerberos sans le moindre ticket, avec le principal
# indiqué (ex : alice.admin@DOCSEARCH.TEST). Permet d'éprouver toute la
# chaîne SSO sans KDC, sans keytab et sans FQDN.
KERBEROS_DEV_PRINCIPAL=
# Contournent le contrôle de GROUPE. L'authentification, elle, reste
# exigée — contrairement à leur comportement précédent, où elles
# dispensaient aussi de toute identité.
ACCESS_AUTH_DISABLED=false
ADMIN_AUTH_DISABLED=false

APP_UID=1000
